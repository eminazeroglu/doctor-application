        {
            "tag": "Blogs",
            "description": "Blogs ilə əlaqəli API endpoint-ləri",
            "endpoints": {
                "/app/blogs": {
                    "get": {
                        "summary": "Blogs siyahısı",
                        "description": "Bütün blogs siyahısını qaytarır",
                        "authorization": false,
                        "query": {
                            "search": {
                                "type": "text",
                                "description": "Axtarış"
                            },
                            "page": {
                                "type": "number",
                                "description": "Səhifə nömrəsi",
                                "default": 1
                            },
                            "limit": {
                                "type": "number",
                                "description": "Səhifə limiti",
                                "default": 20
                            }
                        }
                    }
                },
                "/app/blogs/{slug}": {
                    "get": {
                        "summary": "blog detalları",
                        "description": "blog detallarını qaytarır",
                        "authorization": false
                    }
                }
            }
        },
        {
            "tag": "Kateqoriyalar",
            "description": "Kateqoriyalar ilə əlaqəli API-lər",
            "endpoints": {
                "/app/categories": {
                    "get": {
                        "summary": "Kateqoriya siyahısııı",
                        "description": "Bütün kateqoriyaların siyahısını qaytarır",
                        "query": {
                            "is_home": {
                                "type": "boolean",
                                "description": "1 və ya 0 göndərərək əsas səhifə üçün kateqoriyaları əldə edə bilərsən"
                            }
                        }
                    }
                },
                "/app/categories/{id}/children": {
                    "get": {
                        "summary": "Alt kateqoriyaların siyahısı",
                        "description": "Seçilmiş kateqoriyanın bütün alt kateqoriyalarını qaytarır"
                    }
                },
                "/app/categories/{id}/services": {
                    "get": {
                        "summary": "Kateqoriya xidmətləri siyahısı",
                        "description": "Seçilmiş kateqoriyanın bütün xidmətlərini kateqoriyalarını qaytarır"
                    }
                },
                "/app/categories/{id}/attributes": {
                    "get": {
                        "summary": "Kateqoriya attributları siyahısı",
                        "description": "Seçilmiş kateqoriyanın bütün attributelarını qaytarır"
                    }
                }
            }
        },

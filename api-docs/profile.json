{
    "tag": "Profile",
    "description": "İstifadəçi profil idarəetməsi API-ləri",
    "endpoints": [
        {
            "path": "/app/profile",
            "method": "get",
            "summary": "Profil məlumatları",
            "description": "İstifadəçinin profil məlumatlarını qaytarır",
            "authorization": true
        },
        {
            "path": "/app/profile",
            "method": "put",
            "summary": "Profil yeniləməsi",
            "description": "İstifadəçinin ümumi profil məlumatlarını yeniləyir (ad, soyad, telefon, ünvan)",
            "authorization": true,
            "formBody": {
                "name": {
                    "type": "text",
                    "required": true,
                    "description": "Ad"
                },
                "surname": {
                    "type": "text",
                    "required": true,
                    "description": "Soyad"
                },
                "phone": {
                    "type": "text",
                    "required": true,
                    "description": "Telefon nömrəsi"
                },
                "photo_path": {
                    "type": "text",
                    "description": "Profil şəkli (base64 format)"
                },
                "gender": {
                    "type": "select",
                    "options": ["male", "female"],
                    "description": "Cinsi"
                },
                "birthdate": {
                    "type": "date",
                    "description": "Doğum tarixi"
                }
            }
        },
        {
            "path": "/app/profile/account",
            "method": "put",
            "summary": "Hesab tənzimləmələri",
            "description": "İstifadəçinin email və şifrəsini yeniləyir",
            "authorization": true,
            "formBody": {
                "email": {
                    "type": "email",
                    "required": true,
                    "description": "Email ünvanı"
                },
                "current_password": {
                    "type": "password",
                    "description": "Hazırki şifrə (yeni şifrə təyin edərkən mütləqdir)"
                },
                "password": {
                    "type": "password",
                    "description": "Yeni şifrə (minimum 8 simvol)"
                },
                "password_confirmation": {
                    "type": "password",
                    "description": "Yeni şifrə təkrarı"
                }
            }
        },
        {
            "path": "/app/profile/avatar",
            "method": "post",
            "summary": "Profil şəkli yeniləməsi",
            "description": "İstifadəçinin profil şəklini yeniləyir",
            "authorization": true,
            "formBody": {
                "photo_path": {
                    "type": "text",
                    "required": true,
                    "description": "Base64 formatında şəkil"
                }
            }
        },
        {
            "path": "/app/profile/preferences",
            "method": "get",
            "summary": "İstifadəçi tənzimləmələri",
            "description": "İstifadəçinin tənzimləmələrini qaytarır",
            "authorization": true
        },
        {
            "path": "/app/profile/preferences",
            "method": "put",
            "summary": "Tənzimləmələr yeniləməsi",
            "description": "İstifadəçinin tənzimləmələrini yeniləyir",
            "authorization": true,
            "formBody": {
                "language": {
                    "type": "select",
                    "description": "İnterfeys dili - [\"az\", \"en\", \"ru\", \"tr\"]"
                },
                "dark_mode": {
                    "type": "boolean",
                    "description": "Tünd rejim"
                },
                "notification_settings": {
                    "type": "object",
                    "description": "Bildiriş tənzimləmələri",
                    "default": {
                        "email_notifications": true,
                        "push_notifications": false
                    }
                },
                "privacy_settings": {
                    "type": "object",
                    "description": "Gizlilik tənzimləmələri",
                    "default": {
                        "profile_visibility": "public",
                        "show_online_status": true
                    }
                },
                "timezone": {
                    "type": "text",
                    "description": "Saat qurşağı"
                },
                "email_frequency": {
                    "type": "select",
                    "description": "Email bildirişlərinin tezliyi - [\"daily\", \"weekly\", \"monthly\", \"never\"]"
                }
            }
        },
        {
            "path": "/app/profile/deactivate",
            "method": "post",
            "summary": "Hesabı deaktiv etmək",
            "description": "İstifadəçi hesabını müvəqqəti olaraq deaktiv edir",
            "authorization": true,
            "formBody": {
                "reason": {
                    "type": "select",
                    "required": true,
                    "options": ["platform_dislike", "no_activity", "personal_reasons", "other"],
                    "description": "Deaktivasiya səbəbi"
                },
                "custom_reason": {
                    "type": "text",
                    "description": "Fərdi səbəb (reason=other olduqda mütləqdir)"
                }
            }
        },
        {
            "path": "/app/profile",
            "method": "delete",
            "summary": "Hesabı silmək",
            "description": "İstifadəçi hesabını tamamilə silir",
            "authorization": true,
            "formBody": {
                "reason": {
                    "type": "select",
                    "required": true,
                    "description": "Silinmə səbəbi - [\"platform_dislike\", \"no_activity\", \"personal_reasons\", \"other\"]"
                },
                "custom_reason": {
                    "type": "text",
                    "description": "Fərdi səbəb (reason=other olduqda mütləqdir)"
                },
                "password": {
                    "type": "password",
                    "required": true,
                    "description": "Hazırki şifrə (təsdiq üçün)"
                }
            }
        },
        {
            "path": "/app/profile/doctor/services",
            "method": "get",
            "summary": "Həkimin xidmətləri",
            "description": "Həkimin təklif etdiyi xidmətlərin siyahısını qaytarır",
            "authorization": true,
            "query": {
                "clinic_id": {
                    "type": "integer",
                    "description": "Klinica id"
                }
            }
        },
        {
            "path": "/app/profile/doctor/services",
            "method": "put",
            "summary": "Xidmətlərin bulk yenilənməsi",
            "description": "Həkimin bütün xidmətlərini bir anda yenilər (bulk update). Array formatında göndərilir.",
            "authorization": true,
            "formBody": {
                "services": {
                    "type": "array",
                    "required": true,
                    "description": "Xidmətlər massivi",
                    "default": [
                        {
                            "service_id": 10,
                            "clinic_id": 12,
                            "price": 60.00,
                            "duration": 45,
                            "description": "Yenilənmiş təsvir",
                            "is_active": true
                        },
                        {
                            "service_id": 11,
                            "clinic_id": 12,
                            "price": 40.00,
                            "duration": 20,
                            "description": "Yeni xidmət",
                            "is_active": true
                        }
                    ]
                }
            }
        },
        {
            "path": "/app/profile/doctor/educations",
            "method": "get",
            "summary": "Həkimin təhsil məlumatları",
            "description": "Həkimin təhsil tarixçəsini qaytarır",
            "authorization": true
        },
        {
            "path": "/app/profile/doctor/educations",
            "method": "put",
            "summary": "Təhsil məlumatlarının bulk yenilənməsi",
            "description": "Həkimin bütün təhsil məlumatlarını bir anda yenilər",
            "authorization": true,
            "formBody": {
                "educations": {
                    "type": "array",
                    "required": true,
                    "description": "Təhsil məlumatları massivi",
                    "default": [
                        {
                            "university": "Azərbaycan Tibb Universiteti",
                            "faculty": "Tibb fakultəsi",
                            "degree": "Həkim diplomu",
                            "specialization": "Stomatologiya",
                            "start_date": "2018-09-01",
                            "end_date": "2024-06-30",
                            "location": "Bakı, Azərbaycan",
                            "description": "Stomatologiya üzrə ixtisas",
                            "is_currently_studying": false
                        }
                    ]
                }
            }
        },
        {
            "path": "/app/profile/doctor/experiences",
            "method": "get",
            "summary": "Həkimin iş təcrübəsi",
            "description": "Həkimin iş təcrübəsi məlumatlarını qaytarır",
            "authorization": true
        },
        {
            "path": "/app/profile/doctor/experiences",
            "method": "put",
            "summary": "İş təcrübəsinin bulk yenilənməsi",
            "description": "Həkimin bütün iş təcrübəsi məlumatlarını bir anda yenilər",
            "authorization": true,
            "formBody": {
                "experiences": {
                    "type": "array",
                    "required": true,
                    "description": "İş təcrübəsi massivi",
                    "default": [
                        {
                            "clinic_id": 1,
                            "position": "Baş Stomatoloq",
                            "start_date": "2022-07-01",
                            "location": "Bakı",
                            "description": "Stomatoloji müalicələr",
                            "is_current_job": true
                        },
                        {
                            "clinic_id": 2,
                            "position": "Stomatoloq",
                            "start_date": "2020-01-01",
                            "end_date": "2022-06-30",
                            "location": "Bakı",
                            "is_current_job": false
                        }
                    ]
                }
            }
        },
        {
            "path": "/app/profile/doctor/certificates",
            "method": "get",
            "summary": "Həkimin sertifikatları",
            "description": "Həkimin sertifikat və lisenziyalarını qaytarır",
            "authorization": true,
            "responses": {
                "200": {
                    "certificates": [
                        {
                            "id": 1,
                            "name": "Stomatologiya Sertifikatı",
                            "issuing_organization": "Səhiyyə Nazirliyi",
                            "issue_date": "2022-08-15",
                            "expiry_date": "2027-08-15",
                            "description": "Ümumi stomatologiya üzrə sertifikat",
                            "is_verified": true,
                            "is_expired": false,
                            "document_url": "https://api.doctap.az/storage/certificates/cert1.pdf"
                        }
                    ],
                    "message": "Sertifikatlar uğurla əldə edildi"
                }
            }
        },
        {
            "path": "/app/profile/doctor/certificates",
            "method": "put",
            "summary": "Sertifikatların bulk yenilənməsi",
            "description": "Həkimin bütün sertifikatlarını bir anda yenilər",
            "authorization": true,
            "formBody": {
                "certificates": {
                    "type": "array",
                    "required": true,
                    "description": "Sertifikatlar massivi",
                    "example": [
                        {
                            "id": 1,
                            "_action": "update",
                            "name": "Ümumi Stomatologiya Sertifikatı",
                            "issuing_organization": "Səhiyyə Nazirliyi",
                            "issue_date": "2022-08-15",
                            "expiry_date": "2027-08-15",
                            "description": "Yenilənmiş təsvir"
                        },
                        {
                            "_action": "create",
                            "name": "Ortodontiya Sertifikatı",
                            "issuing_organization": "Beynəlxalq Ortodontiya Federasiyası",
                            "issue_date": "2023-12-01",
                            "expiry_date": "2028-12-01"
                        }
                    ]
                }
            }
        },
        {
            "path": "/app/profile/doctor/languages",
            "method": "get",
            "summary": "Həkimin dil bilikləri",
            "description": "Həkimin danışdığı dilləri qaytarır",
            "authorization": true,
            "responses": {
                "200": {
                    "languages": [
                        {
                            "id": 1,
                            "language": "Azərbaycan dili",
                            "proficiency": "native",
                            "proficiency_text": "Ana dili"
                        },
                        {
                            "id": 2,
                            "language": "İngilis dili",
                            "proficiency": "intermediate",
                            "proficiency_text": "Orta"
                        }
                    ],
                    "message": "Dil bilikləri uğurla əldə edildi"
                }
            }
        },
        {
            "path": "/app/profile/doctor/languages",
            "method": "put",
            "summary": "Dil biliklərinin bulk yenilənməsi",
            "description": "Həkimin bütün dil biliklərini bir anda yenilər",
            "authorization": true,
            "formBody": {
                "languages": {
                    "type": "array",
                    "required": true,
                    "description": "Dil bilikləri massivi",
                    "example": [
                        {
                            "id": 1,
                            "_action": "update",
                            "language": "Azərbaycan dili",
                            "proficiency": "native"
                        },
                        {
                            "id": 2,
                            "_action": "update",
                            "language": "İngilis dili",
                            "proficiency": "fluent"
                        },
                        {
                            "_action": "create",
                            "language": "Türk dili",
                            "proficiency": "intermediate"
                        }
                    ]
                }
            }
        }
    ]
}

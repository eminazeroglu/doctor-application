{
    "tag": "Həkimlər",
    "description": "Doctors ilə əlaqəli API endpoint-ləri",
    "endpoints": [
        {
            "path": "/app/doctors/search",
            "method": "post",
            "summary": "Həkimlərin siyahısı",
            "description": "Bütün doctors siyahısını qaytarır",
            "authorization": false,
            "formBody": {
                "search": {
                    "type": "text",
                    "description": "Axtarış"
                },
                "city_id": {
                    "type": "integer",
                    "description": "Şəhərin id-si"
                },
                "region_id": {
                    "type": "integer",
                    "description": "Rayon id-si"
                },
                "subway_id": {
                    "type": "integer",
                    "description": "Metro id-si"
                },
                "category_id": {
                    "type": "integer",
                    "description": "Kateqoriya id-si"
                },
                "subcategory_id": {
                    "type": "integer",
                    "description": "Sub Kateqoriya id-si"
                },
                "service_id": {
                    "type": "integer",
                    "description": "Xidmət id-si"
                },
                "gender": {
                    "type": "string",
                    "description": "Cinsiyyət: male, female"
                },
                "attributes": {
                    "type": "object",
                    "description": "Dinamik atributlar üzrə axtarış. Açar kimi atribut ID-si, dəyər kimi seçim ID-si və ya dəyər istifadə olunur. Məsələn: {\"1\": 5} - Atribut ID 1 (Marka), Option ID 5 (BMW); {\"2\": 12} - Model, X5; {\"3\": \"2018-2022\"} - İl aralığı; {\"4\": [2,5,7]} - Çoxlu seçim halında (məs: Rənglər).",
                    "default": {
                        "1": [2],
                        "2": [11]
                    }
                },
                "availability_date_range": {
                    "type": "object",
                    "description": "Tarix aralığında müsait həkimlər. {start_date: '2025-09-10', end_date: '2025-09-20'}",
                    "default": {
                        "start_date": "",
                        "end_date": ""
                    }
                },
                "time_of_day": {
                    "type": "array",
                    "description": "Günün müəyyən hissəsində işləyən həkimlər. ['early_morning', 'morning', 'afternoon', 'evening']"
                },
                "page": {
                    "type": "number",
                    "description": "Səhifə nömrəsi",
                    "default": 1
                },
                "limit": {
                    "type": "number",
                    "description": "Səhifə limiti",
                    "default": 20
                }
            }
        },
        {
            "path": "/app/doctors/{username}/view",
            "method": "get",
            "summary": "Həkim məlumatı",
            "description": "Verilən username-ə görə həkimin məlumatlarını qaytarır"
        },
        {
            "path": "/app/doctor/dashboard/summary",
            "method": "get",
            "summary": "Performance overview & KPIs",
            "description": "Verilən tarix intervalında yeni vs mövcud xəstələr faizi və əsas KPI-ları qaytarır.",
            "authorization": true,
            "query": {
                "from": {
                    "type": "text",
                    "description": "Başlanğıc tarix (YYYY-MM-DD)"
                },
                "to": {
                    "type": "text",
                    "description": "Bitmə tarixi (YYYY-MM-DD)"
                }
            },
            "responses": {
                "200": {
                    "range": [
                        "2025-05-01",
                        "2025-05-07"
                    ],
                    "overview": {
                        "new_patients_percent": 20,
                        "existing_patients_percent": 80
                    },
                    "kpis": {
                        "total_appointments": 300,
                        "unique_patients": 180,
                        "new_patients": 60
                    }
                }
            }
        },
        {
            "path": "/app/doctor/dashboard/performance",
            "method": "get",
            "summary": "Performance chart (appointments & new patients)",
            "description": "Interval üzrə (month|week) görüş sayı və yeni xəstələrin trendi.",
            "authorization": true,
            "query": {
                "from": {
                    "type": "text",
                    "description": "Başlanğıc tarix (YYYY-MM-DD)"
                },
                "to": {
                    "type": "text",
                    "description": "Bitmə tarixi (YYYY-MM-DD)"
                },
                "interval": {
                    "type": "text",
                    "description": "month | week",
                    "default": "month"
                }
            },
            "responses": {
                "200": {
                    "range": [
                        "2025-01-01",
                        "2025-07-01"
                    ],
                    "interval": "month",
                    "series": [
                        {
                            "bucket": "2025-01",
                            "appointments": 480,
                            "new_patients": 250
                        },
                        {
                            "bucket": "2025-02",
                            "appointments": 350,
                            "new_patients": 120
                        }
                    ]
                }
            }
        },
        {
            "path": "/app/doctor/dashboard/appointments/report",
            "method": "get",
            "summary": "Appointment report totals",
            "description": "Statuslara görə görüş sayları (confirmed, unconfirmed, reschedule, cancellation, no-show).",
            "authorization": true,
            "query": {
                "from": {
                    "type": "text",
                    "description": "Başlanğıc tarix (YYYY-MM-DD)"
                },
                "to": {
                    "type": "text",
                    "description": "Bitmə tarixi (YYYY-MM-DD)"
                }
            },
            "responses": {
                "200": {
                    "range": [
                        "2025-05-01",
                        "2025-07-05"
                    ],
                    "totals": {
                        "confirmed": 300,
                        "unconfirmed": 40,
                        "practice_reschedules": 250,
                        "practice_cancellations": 10,
                        "patient_cancellations": 60,
                        "patient_no_shows": 3
                    }
                }
            }
        },
        {
            "path": "/app/doctor/dashboard/bookings/recent",
            "method": "get",
            "summary": "Recent booking details",
            "description": "Son rezervlər siyahısı (vaxt aralığı + tarix + pasiyent adı).",
            "authorization": true,
            "query": {
                "limit": {
                    "type": "number",
                    "description": "Qaytarılacaq ədəd",
                    "default": 10
                }
            },
            "responses": {
                "200": {
                    "items": [
                        {
                            "id": 1,
                            "time_range": "10:00 - 11:30",
                            "date_human": "Fri, May 10",
                            "patient_name": "Cameron Williamson"
                        }
                    ]
                }
            }
        },
        {
            "path": "/app/doctor/dashboard/appointments/report/export",
            "method": "get",
            "summary": "Download appointment report (xlsx/csv)",
            "description": "AppointmentStatusEnum statuslarına görə appointment report-u fayl formatında yükləmək üçün endpoint.",
            "authorization": true,
            "query": {
                "from": {
                    "type": "text",
                    "description": "Başlanğıc tarix (YYYY-MM-DD)"
                },
                "to": {
                    "type": "text",
                    "description": "Bitmə tarixi (YYYY-MM-DD)"
                },
                "format": {
                    "type": "text",
                    "description": "Yüklənəcək fayl formatı: xlsx | csv",
                    "default": "xlsx"
                }
            }
        },
        {
            "path": "/app/doctor/calendar",
            "method": "get",
            "summary": "Calendar feed",
            "authorization": true,
            "query": {
                "from": {
                    "type": "text",
                    "description": "YYYY-MM-DD"
                },
                "to": {
                    "type": "text",
                    "description": "YYYY-MM-DD"
                },
                "is_agency": {
                    "type": "boolean",
                    "description": "Agendanın əldə edilməsi üçün true göndəririk",
                    "default": false
                }
            },
            "responses": {
                "200": {
                    "items": []
                }
            }
        },
        {
            "path": "/app/doctor/calendar/availability/recurring",
            "method": "post",
            "summary": "Create recurring availability",
            "authorization": true,
            "formBody": {
                "start_date": {
                    "type": "date",
                    "required": true,
                    "default": "2025-09-04"
                },
                "end_date": {
                    "type": "date",
                    "required": true,
                    "default": "2025-09-04"
                },
                "from_time": {
                    "type": "time",
                    "required": true,
                    "default": "14:00"
                },
                "to_time": {
                    "type": "time",
                    "required": true,
                    "default": "16:00"
                },
                "frequency": {
                    "type": "string",
                    "required": true,
                    "default": "daily",
                    "description": "daily|weekly|monthly"
                },
                "every": {
                    "type": "integer",
                    "required": true,
                    "default": "1"
                },
                "days": {
                    "type": "array",
                    "required": false,
                    "default": [1,3,4]
                },
                "clinic_id": {
                    "type": "integer",
                    "required": false,
                    "default": 3
                }
            }
        },
        {
            "path": "/app/doctor/calendar/availability/recurring/{id}",
            "method": "put",
            "summary": "Update recurring availability",
            "authorization": true,
            "formBody": {
                "start_date": {
                    "type": "date",
                    "required": true,
                    "default": "2025-09-04"
                },
                "end_date": {
                    "type": "date",
                    "required": true,
                    "default": "2025-09-04"
                },
                "from_time": {
                    "type": "time",
                    "required": true,
                    "default": "14:00"
                },
                "to_time": {
                    "type": "time",
                    "required": true,
                    "default": "16:00"
                },
                "frequency": {
                    "type": "string",
                    "required": true,
                    "default": "daily",
                    "description": "daily|weekly|monthly"
                },
                "every": {
                    "type": "integer",
                    "required": true,
                    "default": "1"
                },
                "days": {
                    "type": "array",
                    "required": false,
                    "default": [1,3,4]
                },
                "clinic_id": {
                    "type": "integer",
                    "required": false,
                    "default": 3
                }
            }
        },
        {
            "path": "/app/doctor/calendar/availability/recurring/{id}",
            "method": "delete",
            "summary": "Delete recurring availability",
            "authorization": true
        },
        {
            "path": "/app/doctor/calendar/unavailability",
            "method": "post",
            "summary": "Create unavailability",
            "authorization": true,
            "formBody": {
                "start": {
                    "type": "datetime",
                    "required": true,
                    "description": "YYYY-MM-DD HH:mm",
                    "default": "2025-09-15 16:00"
                },
                "end": {
                    "type": "datetime",
                    "required": true,
                    "description": "YYYY-MM-DD HH:mm",
                    "default": "2025-09-15 18:00"
                },
                "note": {
                    "type": "string"
                }
            }
        },
        {
            "path": "/app/doctor/calendar/unavailability/{id}",
            "method": "delete",
            "summary": "Delete unavailability",
            "authorization": true
        },
        {
            "path": "/app/doctor/appointments",
            "method": "get",
            "summary": "Appointment siyahısı (filter + sort + pagination)",
            "authorization": true,
            "query": {
                "per_page": {
                    "type": "number",
                    "description": "Səhifə ölçüsü (1..100)",
                    "default": 10
                },
                "status": {
                    "type": "string",
                    "description": "Vergüllə ayrılmış çoxlu status: pending,confirmed,cancelled,completed,no-show,rescheduled"
                },
                "clinic_id": {
                    "type": "number",
                    "description": "Klinika ID (doctor_clinic əlaqəsi üzrə)"
                },
                "from": {
                    "type": "date",
                    "description": "Başlanğıc tarix (YYYY-MM-DD)"
                },
                "to": {
                    "type": "date",
                    "description": "Bitmə tarixi (YYYY-MM-DD) — from tarixindən kiçik ola bilməz"
                }
            }
        },
        {
            "path": "/app/doctor/appointments/report",
            "method": "get",
            "summary": "Appointment siyahısı (filter + sort + pagination)",
            "authorization": true,
            "query": {
                "per_page": {
                    "type": "number",
                    "description": "Səhifə ölçüsü (1..100)",
                    "default": 10
                },
                "search": {
                    "type": "string",
                    "description": "Pasiyent adına görə axtarış (name/surname)"
                },
                "status": {
                    "type": "string",
                    "description": "Vergüllə ayrılmış çoxlu status: pending,confirmed,cancelled,completed,no-show,rescheduled"
                },
                "clinic_id": {
                    "type": "number",
                    "description": "Klinika ID (doctor_clinic əlaqəsi üzrə)"
                },
                "from": {
                    "type": "date",
                    "description": "Başlanğıc tarix (YYYY-MM-DD)"
                },
                "to": {
                    "type": "date",
                    "description": "Bitmə tarixi (YYYY-MM-DD) — from tarixindən kiçik ola bilməz"
                }
            }
        },
        {
            "path": "/app/doctor/appointments/{id}",
            "method": "get",
            "summary": "Appointment detalları",
            "authorization": true
        },
        {
            "path": "/app/doctor/appointments/{id}/status",
            "method": "put",
            "summary": "Appointment statusunu dəyiş",
            "authorization": true,
            "formBody": {
                "status": {
                    "type": "string",
                    "required": true,
                    "default": "pending",
                    "description": [
                        "pending",
                        "confirmed",
                        "cancelled",
                        "completed",
                        "no-show",
                        "rescheduled"
                    ]
                }
            }
        },
        {
            "path": "/app/doctor/appointments/{id}/reschedule",
            "method": "put",
            "summary": "Appointment üçün yeni tarix/saat təyin et",
            "authorization": true,
            "formBody": {
                "start": {
                    "type": "datetime",
                    "required": true,
                    "description": "YYYY-MM-DD HH:mm",
                    "default": "2025-09-14 14:00"
                },
                "end": {
                    "type": "datetime",
                    "required": true,
                    "description": "YYYY-MM-DD HH:mm (start-dan sonra)",
                    "default": "2025-09-14 17:00"
                },
                "clinic_id": {
                    "type": "number",
                    "required": false,
                    "description": "Yeni klinika (boş buraxılsa hazırkı qalır)",
                    "default": "3"
                },
                "service_id": {
                    "type": "number",
                    "required": false,
                    "description": "Yeni servis (boş buraxılsa hazırkı qalır)",
                    "default": "6"
                }
            }
        },
        {
            "path": "/app/doctor/appointments/{id}/note",
            "method": "put",
            "summary": "Appointment üçün qeyd (note) əlavə/yenilə",
            "authorization": true,
            "formBody": {
                "note": {
                    "type": "string",
                    "required": true,
                    "max": 1000
                }
            }
        },
        {
            "path": "/app/doctor/appointments/{uuid}",
            "method": "delete",
            "authorization": true,
            "summary": "Randevu ləğv etmə",
            "description": "Randevunu ləğv etmək üçün uuid göndəririk",
            "formBody": {
                "reasons": {
                    "type": "array",
                    "required": true,
                    "description": "Burda səbəbləri göndəririk. 'doctor_dislike' => 'Həkimi bəyənmirəm',\n 'time_conflict' => 'Vaxtım uyğun gəlmir',\n 'found_another_doctor' => 'Başqa həkim tapdım',\n 'personal_reason' => 'Şəxsi səbəbə görə',",
                    "default": [
                        "doctor_dislike",
                        "time_conflict"
                    ]
                },
                "custom_reason": {
                    "type": "text",
                    "required": true,
                    "description": "Səbəb",
                    "default": "Burda istifadəçinin başqa səbəbi yazılır"
                }
            }
        }
    ]
}

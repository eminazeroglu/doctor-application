{
    "tag": "Kateqoriyalar",
    "description": "Kateqoriyalar ilə əlaqəli API-lər",
    "endpoints": [
        {
            "path": "/app/categories",
            "method": "get",
            "summary": "Kateqoriya siyahısııı",
            "description": "Bütün kateqoriyaların siyahısını qaytarır",
            "query": {
                "is_home": {
                    "type": "boolean",
                    "description": "1 və ya 0 göndərərək əsas səhifə üçün kateqoriyaları əldə edə bilərsən"
                }
            }
        },
        {
            "path": "/app/categories/{id}/children",
            "method": "get",
            "summary": "Alt kateqoriyaların siyahısı",
            "description": "Seçilmiş kateqoriyanın bütün alt kateqoriyalarını qaytarır"
        },
        {
            "path": "/app/categories/{id}/services",
            "method": "get",
            "summary": "Kateqoriya xidmətləri siyahısı",
            "description": "Seçilmiş kateqoriyanın bütün xidmətlərini kateqoriyalarını qaytarır"
        },
        {
            "path": "/app/categories/{id}/attributes",
            "method": "get",
            "summary": "Kateqoriya attributları siyahısı",
            "description": "Seçilmiş kateqoriyanın bütün attributelarını qaytarır"
        }
    ]
}

{
    "tag": "Autentifikasiya",
    "description": "İstifadəçi giriş, qeydiyyat, çıxış və s. əməliyyatları üçün API-lər",
    "endpoints": [
        {
            "path": "/auth/register",
            "method": "post",
            "summary": "Yeni İstifadəçi",
            "description": "Yeni istifadəçi əlavə edir",
            "formBody": {
                "name": {
                    "type": "text",
                    "required": true,
                    "description": "İstifadəçinin adı.",
                    "default": "John"
                },
                "surname": {
                    "type": "text",
                    "required": true,
                    "description": "İstifadəçinin soyadı",
                    "default": "Doe"
                },
                "birthdate": {
                    "type": "date",
                    "required": true,
                    "description": "İstifadəçi doğum tarixi",
                    "default": "1990-05-05"
                },
                "gender": {
                    "type": "text",
                    "required": true,
                    "description": "Burda enum olur ya male/female olmalıdır",
                    "default": "male"
                },
                "phone": {
                    "type": "text",
                    "required": true,
                    "description": "Burda telefon nömrəsi olur nümunə - 994552343434",
                    "default": "994552343434"
                },
                "email": {
                    "type": "text",
                    "required": true,
                    "description": "İstifadəçinin email ünvanı",
                    "default": "user1@example.com"
                },
                "password": {
                    "type": "text",
                    "required": true,
                    "description": "İstifadəçinin şifrəsi",
                    "default": "eE12345!@#"
                },
                "password_confirmation": {
                    "type": "text",
                    "required": true,
                    "description": "İstifadəçinin şifrə təkrarı",
                    "default": "eE12345!@#"
                },
                "user_type": {
                    "type": "text",
                    "required": true,
                    "description": "İstifadəçinin şifrə təkrarı - 'user' or 'doctor'",
                    "default": "user"
                }
            },
            "responses": {
                "200": {
                    "message": "Hesabınız uğurla yaradıldı! Təsdiq üçün email ünvanınıza link göndərildi"
                },
                "422": {
                    "name": "Zəhmət olmasa boş buraxmayın",
                    "surname": "Zəhmət olmasa boş buraxmayın",
                    "email": "Zəhmət olmasa boş buraxmayın",
                    "password": "Zəhmət olmasa boş buraxmayın",
                    "password_confirmation": "Zəhmət olmasa boş buraxmayın"
                }
            }
        },
        {
            "path": "/auth/login",
            "method": "post",
            "summary": "İstifadəçinin daxil olması",
            "description": "İstifadəçinin sistemə daxil olması",
            "formBody": {
                "email": {
                    "type": "text",
                    "required": true,
                    "description": "İstifadəçinin email ünvanı",
                    "default": "user@example.com"
                },
                "password": {
                    "type": "text",
                    "required": true,
                    "description": "İstifadəçinin şifrəsi",
                    "default": "password123"
                }
            },
            "responses": {
                "200": {
                    "token": "1|4WHKo6K0AZNGiPiL9QWs1qXZ2CwnYbaCQyfUYr8M1f224977",
                    "user": {
                        "uuid": "92d1472d-6905-4bdf-9229-3fcac1988a6c",
                        "fullname": "John Doe",
                        "name": "John",
                        "surname": "Doe",
                        "username": "john-doe",
                        "code": "LR3XII",
                        "email": "user@example.com",
                        "gender": "",
                        "phone": "(731) 902-6895",
                        "photo": "https://gojob-az.test/uploads/photos/user/photo-3.jpg",
                        "is_active": true,
                        "is_block": false,
                        "role": "user"
                    }
                },
                "422": {
                    "email": "Zəhmət olmasa boş buraxmayın",
                    "password": "Zəhmət olmasa boş buraxmayın"
                }
            }
        },
        {
            "path": "/auth/logout",
            "method": "post",
            "summary": "İstifadəçinin hesabdan çıxması",
            "description": "İstifadəçinin sistemdən çıxış etməsi",
            "authorization": true,
            "responses": {
                "200": {
                    "message": "Hesabdan uğurla çıxdınız"
                }
            }
        },
        {
            "path": "/auth/user",
            "method": "get",
            "summary": "Daxil olan istifadəçi məlumatları",
            "description": "Daxil olan istifadəçinin sistemdə olan məlumatları",
            "authorization": true,
            "responses": {
                "200": {
                    "uuid": "92d1472d-6905-4bdf-9229-3fcac1988a6c",
                    "fullname": "John Doe",
                    "name": "John",
                    "surname": "Doe",
                    "username": "john-doe",
                    "code": "LR3XII",
                    "email": "user@example.com",
                    "gender": "",
                    "phone": "(731) 902-6895",
                    "photo": "https://gojob-az.test/uploads/photos/user/photo-3.jpg",
                    "is_active": true,
                    "is_block": false,
                    "role": "user"
                }
            }
        },
        {
            "path": "/auth/refresh",
            "method": "post",
            "summary": "İstifadəçinin tokenini yeniləmək",
            "description": "İstifadəçinin sistemdə tokenini yeniləyir",
            "authorization": true,
            "responses": {
                "200": {
                    "token": "6|fqvImeIpeX1svxO5XK3giLlcNWWaOqdQz5SMcKBIc8660478"
                }
            }
        },
        {
            "path": "/auth/forgot-password",
            "method": "post",
            "summary": "Şifrəmi unutdum",
            "description": "Şifrəsini unutmuş istifadəçi üçün istifadə olunur",
            "formBody": {
                "email": {
                    "type": "text",
                    "required": true,
                    "description": "İstifadəçinin email ünvanı",
                    "default": "user@example.com"
                }
            },
            "responses": {
                "200": {
                    "message": "Şifrə dəyişmə linki uğurla göndərildi"
                },
                "422": {
                    "email": "Zəhmət olmasa boş buraxmayın"
                }
            }
        },
        {
            "path": "/auth/reset-password",
            "method": "post",
            "summary": "Şifrəni yeniləmək",
            "description": "Şifrəsini yeniləmək istəyən istifadəçi üçün istifadə olunur",
            "formBody": {
                "code": {
                    "type": "text",
                    "required": true,
                    "description": "Emaildən gələn kod"
                },
                "password": {
                    "type": "text",
                    "required": true,
                    "description": "İstifadəçinin şifrəsi",
                    "default": "12345678"
                },
                "password_confirmation": {
                    "type": "text",
                    "required": true,
                    "description": "İstifadəçinin şifrə təkrarı",
                    "default": "12345678"
                }
            },
            "responses": {
                "200": {
                    "token": "7|5jcZjSljmeQ59J2qUssD0gxXuU3WG4y625piz9lW29e005f4",
                    "user": {
                        "uuid": "92d1472d-6905-4bdf-9229-3fcac1988a6c",
                        "fullname": "John Doe",
                        "name": "John",
                        "surname": "Doe",
                        "username": "john-doe",
                        "code": "LR3XII",
                        "email": "user@example.com",
                        "gender": "",
                        "phone": "(731) 902-6895",
                        "photo": "https://gojob-az.test/uploads/photos/user/photo-3.jpg",
                        "is_active": true,
                        "is_block": false,
                        "role": "user"
                    }
                },
                "422": {
                    "token": "Zəhmət olmasa boş buraxmayın",
                    "password": "Zəhmət olmasa boş buraxmayın",
                    "password_confirmation": "Zəhmət olmasa boş buraxmayın"
                },
                "400": {
                    "error": "BaseException",
                    "message": "Token etibarsızdır və ya istifadə müddəti bitib."
                }
            }
        },
        {
            "path": "/auth/email/verify",
            "method": "post",
            "summary": "Email təsdiqləmək",
            "description": "Emaildən gələn key parametri ilə istifadəçinin email ünvanını təsdiqləməsi",
            "formBody": {
                "key": {
                    "type": "text",
                    "required": true,
                    "description": "Emaildən gələn key"
                }
            },
            "responses": {
                "200": {
                    "message": "Email uğurla təsdiqləndi"
                },
                "422": {
                    "key": "Zəhmət olmasa boş buraxmayın"
                }
            }
        },
        {
            "path": "/auth/email/resend",
            "method": "post",
            "summary": "Emailə yenidən təsdiq linki göndərmək",
            "description": "Emailə yenidən təsdiq linki göndərmək üçün istifadə olunur",
            "responses": {
                "200": {
                    "message": "Təsdiq emaili uğurla yenidən göndərildi"
                },
                "422": {
                    "key": "Zəhmət olmasa boş buraxmayın"
                }
            }
        }
    ]
}
